# ------- قاعدة البيانات -------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/evo_store"

# ------- الأمان -------
# مفتاح توقيع الجلسات — 32 حرفًا على الأقل. ولّده بأمر:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="change-me-to-a-long-random-string-min-32-chars"

# مفتاح تشفير أسرار المزوّدين (at-rest). اختياري — إن تُرك فارغًا يُشتق من SESSION_SECRET.
# للإنتاج يُفضّل تعيين مفتاح مستقل: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PROVIDER_ENCRYPTION_KEY=""

# سر تشغيل مهام المتابعة الدورية (cron) — لحماية /api/cron/*
CRON_SECRET=""

# ------- التطبيق -------
APP_BASE_URL="http://localhost:3000"
NODE_ENV="development"

# تخزين المرفقات: الافتراضي داخل قاعدة البيانات (متوافق مع Vercel/serverless).
# لتخزينها على القرص محليًا فقط: STORAGE_DRIVER="disk"
# STORAGE_DRIVER=""
# STORAGE_DIR=""

# ------- Binance Pay (الشحن التلقائي) -------
# من بوابة تاجر Binance: merchant.binance.com → API Management
# اضبط Webhook URL في البوابة على: https://<نطاقك>/api/webhooks/binance
BINANCE_PAY_API_KEY=""
BINANCE_PAY_API_SECRET=""
# القاعدة الافتراضية https://bpay.binanceapi.com — لا تغيّرها إلا للاختبار
BINANCE_PAY_BASE_URL=""
# احتياطي (غير مستخدم حاليًا)
BINANCE_PAY_CERT_SN=""

# ------- التخزين S3 (مرحلة لاحقة) -------
S3_ENDPOINT=""
S3_KEY=""
S3_SECRET=""
S3_BUCKET=""

# ------- البريد (مرحلة لاحقة) -------
MAIL_HOST=""
MAIL_PORT=""
MAIL_USER=""
MAIL_PASS=""
MAIL_FROM="Evo Store <no-reply@evo.store>"
